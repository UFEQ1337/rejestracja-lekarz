  },
  "components": {
    "schemas": {
      "PatientRequest": {
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string",
            "maxLength": 60,
            "minLength": 0
          },
          "lastName": {
            "type": "string",
            "maxLength": 80,
            "minLength": 0
          },
          "pesel": {
            "type": "string",
            "example": "90010112345",
            "minLength": 1,
            "pattern": "\\d{11}"
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 120,
            "minLength": 0
          },
          "phone": {
            "type": "string",
            "pattern": "^$|^\\+?[0-9 ]{9,15}$"
          },
          "birthDate": {
            "type": "string",
            "format": "date"
          }
        },
        "required": [
          "email",
          "firstName",
          "lastName",
          "pesel"
        ]
      },
      "PatientResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "fullName": {
            "type": "string"
          },
          "pesel": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "birthDate": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "DoctorRequest": {
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string",
            "maxLength": 60,
            "minLength": 0
          },
          "lastName": {
            "type": "string",
            "maxLength": 80,
            "minLength": 0
          },
          "licenseNumber": {
            "type": "string",
            "example": "1234567",
            "minLength": 1,
            "pattern": "\\d{7}"
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 120,
            "minLength": 0
          },
          "phone": {
            "type": "string",
            "example": "+48 61 123 45 67",
            "pattern": "^$|^\\+?[0-9 ]{9,15}$"
          },
          "room": {
            "type": "string",
            "maxLength": 10,
            "minLength": 0
          },
          "specializationIds": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int64"
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "email",
          "firstName",
          "lastName",
          "licenseNumber",
          "specializationIds"
        ]
      },
      "DoctorResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "fullName": {
            "type": "string"
          },
          "licenseNumber": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "room": {
            "type": "string"
          },
          "specializations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SpecializationResponse"
            }
          }
        }
      },
      "SpecializationResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "SpecializationRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 0
          }
        },
        "required": [
          "name"
        ]
      },
      "TimeSlotRequest": {
        "type": "object",
        "properties": {
          "startTime": {
            "type": "string",
            "format": "date-time",
            "example": "2026-11-20T09:00:00"
          },
          "endTime": {
            "type": "string",
            "format": "date-time",
            "example": "2026-11-20T09:20:00"
          }
        },
        "required": [
          "endTime",
          "startTime"
        ]
      },
      "TimeSlotResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "doctorId": {
            "type": "integer",
            "format": "int64"
          },
          "doctorName": {
            "type": "string"
          },
          "startTime": {
            "type": "string",
            "format": "date-time"
          },
          "endTime": {
            "type": "string",
            "format": "date-time"
          },
          "available": {
            "type": "boolean"
          }
        }
      },
      "RegisterRequest": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 50,
            "minLength": 4,
            "pattern": "[a-zA-Z0-9._-]+"
          },
          "password": {
            "type": "string",
            "maxLength": 72,
            "minLength": 8
          },
          "patient": {
            "$ref": "#/components/schemas/PatientRequest"
          }
        },
        "required": [
          "password",
          "patient",
          "username"
        ]
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "example": "mpopielarz",
            "minLength": 1
          },
          "password": {
            "type": "string",
            "example": "Pacjent123!",
            "minLength": 1
          }
        },
        "required": [
          "password",
          "username"
        ]
      },
      "TokenResponse": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "tokenType": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "user": {
            "$ref": "#/components/schemas/UserInfo"
          }
        }
      },
      "UserInfo": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "username": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "PATIENT",
              "RECEPTIONIST",
              "DOCTOR"
            ]
          },
          "displayName": {
            "type": "string"
          },
          "patientId": {
            "type": "integer",
            "format": "int64"
          },
          "doctorId": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "AppointmentCreateRequest": {
        "type": "object",
        "properties": {
          "slotId": {
            "type": "integer",
            "format": "int64"
          },
          "patientId": {
            "type": "integer",
            "format": "int64",
            "description": "Wymagane tylko dla rejestratorki; pacjent rezerwuje zawsze dla siebie"
          },
          "reason": {
            "type": "string",
            "maxLength": 500,
            "minLength": 0
          }
        },
        "required": [
          "slotId"
        ]
      },
      "AppointmentResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "status": {
            "type": "string",
            "enum": [
              "BOOKED",
              "CANCELLED",
              "COMPLETED"
            ]
          },
          "reason": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "cancelledAt": {
            "type": "string",
            "format": "date-time"
          },
          "slotId": {
            "type": "integer",
            "format": "int64"
          },
          "startTime": {
            "type": "string",
            "format": "date-time"
          },
          "endTime": {
            "type": "string",
            "format": "date-time"
          },
          "doctorId": {
            "type": "integer",
            "format": "int64"
          },
          "doctorName": {
            "type": "string"
          },
          "room": {
            "type": "string"
          },
          "patientId": {
            "type": "integer",
            "format": "int64"
          },
          "patientName": {
            "type": "string"
          }
        }
      },
      "AppointmentStatusRequest": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "BOOKED",
              "CANCELLED",
              "COMPLETED"
            ],
            "example": "CANCELLED"
          }
        },
        "required": [
          "status"
        ]
      },
      "ErrorResponse": {
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "integer",
            "format": "int32"
          },
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "violations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldViolation"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}