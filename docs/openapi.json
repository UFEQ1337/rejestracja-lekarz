              "format": "int64"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Termin usuniÄ™ty"
          },
          "409": {
            "description": "Termin jest zarezerwowany",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
